{
  "$schema": "https://opencode.ai/v2/cli.json",
  "attention": {
    "notifications": true,
    "sound": false
  },
  "tabs": {
    "mode": "off"
  },
  "session": {
    "scrollbar": true,
    "tps": true,
    "sidebar": "auto",
    "markdown": "rendered"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "session.first": "alt+home",
    "input.line.home": "ctrl+a,home",
    "input.line.end": "ctrl+e,end",
    "input.select.line.home": "ctrl+shift+a,shift+home",
    "input.select.line.end": "ctrl+shift+e,shift+end",
    "prompt.stash": "alt+s",
    "prompt.stash.pop": "alt+o",
    "prompt.stash.list": "alt+l"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "image_preview": true
  },
  "theme": {
    "mode": "system",
    "name": "opencode"
  },
  "animations": true
}
